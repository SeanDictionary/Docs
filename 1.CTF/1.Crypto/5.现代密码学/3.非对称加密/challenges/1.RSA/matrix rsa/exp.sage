from Crypto.Util.number import *

n = 
e = 65537
q = 11170805849671392226933995746004430454186117178373094314265414216515233697999247246384525456844440980401956690377727869698330856032696510089932660773339023
p = 7911679898199972801943073656201269367996226159329425372758409551970876764331240792213432670460833488550486002102080745982406978572635243957541706720700457
c = [[, , , ], 
     [, , , ],
     [, , , ],
     [, , , ]]

c = Matrix(Zmod(n), c)

fun = lambda x, n: prod(x^n-x^i for i in range(n))

g = fun(p, 4) * fun(q, 4)

d = pow(e, -1, g)
m = c ^ d
flag = b"".join(long_to_bytes(int(m[0][i])) for i in range(4))
print(flag)

# flag{it_will_show_you_how_matrix_RSA_works}
