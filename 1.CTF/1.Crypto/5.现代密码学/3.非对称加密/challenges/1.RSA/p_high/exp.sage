from Crypto.Util.number import *

n = 
c = 
e = 65537
p_high = 7246004417660416693624023297487645915238953097136107347308301665030142835514966233343586 << 220

R.<x> = PolynomialRing(Zmod(n))
f = p_high + x
res = f.small_roots(X = 2^220,beta = 0.4)
if res != []:
    p = p_high + int(res[0])
    q = n // p
    d = inverse(e,(p-1)*(q-1))
    m = pow(c,d,n)
    print(long_to_bytes(int(m)))