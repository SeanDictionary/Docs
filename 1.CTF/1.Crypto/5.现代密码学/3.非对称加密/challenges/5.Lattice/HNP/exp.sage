from Crypto.Util.number import *

c = [3112836407052111693223065391682323422625948167959096463888081855471887162548062471508879436942493115296538009697990822306648484620855111328292292829692510, 1406736647461423419306961326617641409697961083947337616189705515720456842385381267299993388207938388326118593828813926240723378523669344452901513836888820, 2003249141315196229037819159401509920601118054837378258861506274468158889595875248507056938402689035828696396801589751399788922859758205437571518244665674, 2323895629105776642844763160439278486087631606970815626601672141454818374884082168990642903495037658321957397612769292433158199101698535020069560541060670, 1966392277413082778256965275650556768277662108736276153708088880153226673654445872468559964505908678363148126946251678033552508631096907185352340749334675]
m = 8898880162277935596507473798023574110967893398902247153376041639617383560318345890876575959967854941738718150545022979900681343145816549592071296283230353

ge = [
[m,0,0,0,0,0],
[0,m,0,0,0,0],
[0,0,m,0,0,0],
[0,0,0,m,0,0],
[c[0],c[1],c[2],c[3],1,0],
[c[1],c[2],c[3],c[4],0,1]]
 
Ge = Matrix(ZZ,ge)
L = Ge.LLL()
a = abs(L[0][-2])
seed = c[0]*inverse(a,m)%m
print(long_to_bytes(int(seed)))

